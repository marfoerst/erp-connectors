# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# In production this file is the container's `env_file` — see docs/DEPLOYMENT.md.

# --- Shopify ---
# From the Partner Dashboard (or written by `npm run config:link`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The app's public HTTPS origin. Must match `application_url` in
# shopify.app.toml exactly, or OAuth and the embedded iframe both break.
# Local dev: https://localhost:3000
SHOPIFY_APP_URL=

# Must match `access_scopes` in shopify.app.toml. `read_all_orders` is
# deliberately absent: it needs separate Shopify approval and only serves
# reprocessing of orders older than 60 days, which is a Should, not a Must.
SCOPES=read_orders,read_customers,read_products

# --- Database ---
# Local dev: a SQLite file next to the schema.
#   DATABASE_URL="file:./dev.sqlite"
# PRODUCTION: an absolute path on the mounted volume. A SQLite file inside the
# container image is lost on every redeploy, and losing the OrderSync table
# loses the double-booking guard — under GoBD a duplicate posting cannot be
# withdrawn, only corrected with a credit note.
DATABASE_URL="file:/data/prod.sqlite"

# --- Connector ---
# Encrypts the merchant's Scopevisio credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
#
# ⚠️ Generate ONCE and back it up somewhere durable. Changing it makes every
# stored credential undecryptable and every merchant has to reconnect.
#
# Deliberately not configurable from the Shopify UI — a tenant must not choose
# the key that protects their own secrets.
SCOPEVISIO_ENCRYPTION_KEY=

# --- Merchant-facing links ---
# Surfaced in the app's footer. Not review-gated for a custom app, but the
# merchant still needs both, and level 1 protected-data handling requires
# telling them what is processed and why.
SUPPORT_URL=
PRIVACY_POLICY_URL=

# --- Runtime (set by docker-compose; defaults are fine elsewhere) ---
NODE_ENV=production
PORT=3000

# Only for a store on a non-standard domain. Leave unset otherwise.
# SHOP_CUSTOM_DOMAIN=

# Everything else — customer number, organisation, user, password, customer
# groups, number ranges and tax cases — is configured by the merchant inside
# the embedded app. There are intentionally no Scopevisio tenant settings here.
