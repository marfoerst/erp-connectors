{
  "name": "@erp/connector-shopify",
  "private": true,
  "type": "module",
  "description": "Books paid Shopify orders into Scopevisio.",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev --config local --use-localhost --localhost-port 3000",
    "dev:tunnel": "shopify app dev",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:orders": "node --import tsx scripts/e2e-orders.mjs",
    "e2e:csv": "node --import tsx scripts/e2e-csv-flow.mjs",
    "e2e:intake": "node --import tsx scripts/e2e-intake.mjs",
    "e2e": "npm run e2e:intake && npm run e2e:csv && npm run e2e:orders"
  },
  "dependencies": {
    "@erp/scopevisio-core": "*",
    "@prisma/client": "^6.2.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^4.1.0",
    "@shopify/shopify-app-session-storage-prisma": "9.0.1",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@remix-run/route-config": "^2.16.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@shopify/cli": "^4.7.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "vite": "^6.2.2"
  }
}
