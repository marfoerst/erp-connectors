# A Magento 2.4.9 (Open Source) runtime for testing the connector against.
#
# Dev only. Packages come from the Mage-OS mirror of repo.magento.com, which
# serves the genuine magento/* packages without Adobe Marketplace keys.
FROM php:8.3-apache

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libfreetype6-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
      libicu-dev libxslt1-dev libzip-dev \
      unzip git mariadb-client \
 && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
 && docker-php-ext-install -j"$(nproc)" bcmath gd intl pdo_mysql soap xsl zip sockets opcache ftp \
 && a2enmod rewrite headers \
 && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN { \
      echo 'memory_limit = 4G'; \
      echo 'max_execution_time = 1800'; \
      echo 'realpath_cache_size = 10M'; \
      echo 'realpath_cache_ttl = 7200'; \
      echo 'opcache.memory_consumption = 512'; \
      echo 'opcache.max_accelerated_files = 60000'; \
      echo 'opcache.validate_timestamps = 1'; \
    } > /usr/local/etc/php/conf.d/magento.ini

# Listen on 8080 inside the container too, so the base URL is the same from the
# host browser and from inside the container.
RUN sed -ri 's/Listen 80$/Listen 8080/' /etc/apache2/ports.conf \
 && { \
      echo '<VirtualHost *:8080>'; \
      echo '  DocumentRoot /var/www/html/pub'; \
      echo '  <Directory /var/www/html>'; \
      echo '    AllowOverride All'; \
      echo '    Require all granted'; \
      echo '  </Directory>'; \
      echo '</VirtualHost>'; \
    } > /etc/apache2/sites-available/000-default.conf

ENV COMPOSER_MEMORY_LIMIT=-1 COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www/html
EXPOSE 8080
