<?xml version="1.0"?>
<!--
    The outbox. An observer writes a row when an invoice is paid or a credit
    memo is created; cron delivers it to the connector with retries.

    Delivery is never attempted inside the checkout or invoice transaction: a
    slow or unreachable ERP connector must not be able to fail a sale. The
    unique key makes enqueueing idempotent, so the observer and the sweep job
    can both write the same event without producing two deliveries.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="scopevisio_outbox" resource="default" engine="innodb" comment="Scopevisio connector outbox">
        <column xsi:type="int" name="outbox_id" unsigned="true" nullable="false" identity="true" comment="Outbox ID"/>
        <column xsi:type="varchar" name="event" length="64" nullable="false" comment="invoice.paid | creditmemo.created"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Invoice or credit memo entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Order entity ID"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="pending" comment="pending | delivered | failed"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Delivery attempts"/>
        <column xsi:type="timestamp" name="next_attempt_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Next attempt (UTC)"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last delivery error"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created (UTC)"/>
        <column xsi:type="timestamp" name="delivered_at" nullable="true" comment="Delivered (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="outbox_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SCOPEVISIO_OUTBOX_EVENT_ENTITY_ID">
            <column name="event"/>
            <column name="entity_id"/>
        </constraint>
        <index referenceId="SCOPEVISIO_OUTBOX_STATUS_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
    </table>
</schema>
