# Copy to `.env`. Never commit the filled-in version.

# The public origin this service is reachable at — from the merchant's browser
# (the activation popup, the admin link) and from the Magento server (the
# integration endpoint, webhooks). Configure the same value in Magento under
# Stores → Configuration → Scopevisio → Connector-URL.
APP_URL=http://localhost:3200
PORT=3200

# --- Storage ---
DATABASE_URL="file:./dev.sqlite"

# --- Connector ---
# Encrypts the merchant's Scopevisio credentials and the Magento OAuth tokens
# at rest (AES-256-GCM), and keys the admin session cookie.
# Generate once with: openssl rand -base64 32
# Changing it makes every stored credential undecryptable.
SCOPEVISIO_ENCRYPTION_KEY=

# How often to poll each store for paid invoices the webhook path missed.
# 0 switches polling off; the outbox in the Magento module already retries.
POLL_INTERVAL_MINUTES=10

# Dev only. When Magento reports a base URL this service cannot reach (a
# container that calls itself localhost), talk to it here instead. Leave empty
# in production.
MAGENTO_URL_OVERRIDE=
