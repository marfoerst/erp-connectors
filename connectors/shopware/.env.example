# Copy to `.env`. Never commit the filled-in version.

# --- This app's identity in Shopware ---
# Must match <name> and <secret> in manifest.xml. The secret is what Shopware
# signs the registration request with, so the two have to agree exactly.
SHOPWARE_APP_NAME=ScopevisioConnector
SHOPWARE_APP_SECRET=

# The public HTTPS origin this service is reachable at. Shopware calls back to
# it during registration, so localhost only works with a tunnel.
APP_URL=https://localhost:3100
PORT=3100

# --- Storage ---
DATABASE_URL="file:./dev.sqlite"

# --- Connector ---
# Encrypts the merchant's Scopevisio credentials at rest (AES-256-GCM).
# Generate once with: openssl rand -base64 32
# Changing it makes every stored credential undecryptable.
SCOPEVISIO_ENCRYPTION_KEY=
