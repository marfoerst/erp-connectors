{
  "name": "erp-connectors",
  "private": true,
  "type": "module",
  "description": "Connectors that bring third-party systems into Scopevisio.",
  "workspaces": [
    "packages/*",
    "connectors/*"
  ],
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "npm run --workspace @erp/connector-shopify",
    "shopware": "npm run --workspace @erp/connector-shopware"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7"
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
