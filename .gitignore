node_modules
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*
# The template for it is not a secret and must be committed.
!.env.example

# package-lock.json is deliberately NOT ignored: the Dockerfile runs `npm ci`,
# which fails outright without a lockfile. Ignoring it meant the image built on
# a machine that happened to have one and failed from a clean clone — which is
# how the app is actually deployed.
yarn.lock
pnpm-lock.yaml

/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Per-connector generated code and local databases
connectors/*/generated/
connectors/*/prisma/*.sqlite
connectors/*/prisma/*.sqlite-journal
